    {
      "name": "4. Balances and settle-up",
      "item": [
        {
          "name": "Get balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/groups/{{groupId}}/balances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups",
                "{{groupId}}",
                "balances"
              ]
            },
            "description": "Positive = is owed money, negative = owes money.",
            "body": {
              "mode": "raw",
              "raw": [
                "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Balances add up to zero', function () {",
                "  const total = pm.response.json().reduce((sum, b) => sum + b.balance, 0);",
                "  pm.expect(Math.abs(total)).to.be.below(0.005);",
                "});"
              ],
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get settlements (who pays whom)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/groups/{{groupId}}/settlements",
              "host": [
                "{{baseUrl}}"
